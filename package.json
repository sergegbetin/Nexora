{
  "name": "nexora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --ssr src/ssr-entry.tsx --outDir .ssr-build --emptyOutDir && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check:routes": "node scripts/ssr-smoke.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:ui": "node scripts/ui-audit.mjs",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "fonts": "node scripts/fetch-fonts.mjs",
    "verify": "npm run lint && npm run build && npm run check:routes && npm run audit && npm run audit:ui && npm run audit:visual",
    "preview": "vite preview"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^8.3.1"
  }
}
